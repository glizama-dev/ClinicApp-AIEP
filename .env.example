# Copia este archivo a .env (en la raiz del repo) y ajusta los valores.
# docker-compose lo lee automaticamente; el backend Node tambien.

NODE_ENV=development
PORT=3000

# --- Base de datos ---
# DB_HOST=db  -> nombre del servicio en docker-compose (usar 'localhost' si corres el backend fuera de Docker)
DB_HOST=db
DB_PORT=3306
DB_USER=clinicapp
DB_PASSWORD=clinicapp
DB_NAME=clinicapp

# Password de root de MySQL (solo lo usa el contenedor db).
MYSQL_ROOT_PASSWORD=root

# --- JWT ---
# Genera una clave aleatoria (no la dejes vacia):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES=8h

# --- Registro ---
ALLOWED_EMAIL_DOMAIN=@correoaiep.cl

# --- Recuperacion de contrasena (correo enviado via Brevo, API HTTPS) ---
# Railway bloquea SMTP saliente en el plan gratuito, por eso se usa la API HTTP
# de Brevo (https://app.brevo.com) en vez de SMTP directo. Crea una cuenta,
# verifica un remitente (Settings > Senders) y genera una API key
# (Settings > SMTP & API > API Keys).
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=ClinicApp

# URL base publica del sitio, usada para construir el link del correo de recuperacion.
APP_BASE_URL=http://localhost:3000

# --- CORS (el frontend lo sirve el mismo Express, asi que apunta a si mismo) ---
CORS_ORIGIN=http://localhost:3000

# --- Semillas (opcional; valores por defecto si se omiten) ---
SEED_ADMIN_EMAIL=admin@correoaiep.cl
SEED_ADMIN_PASSWORD=admin12345
